    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json).filter(l => l.tier);\nconst n = leads.length;\nif (!n) return [{ json: { html: '<p>No leads this period.</p>' } }];\nconst by = t => leads.filter(l => l.tier === t);\nconst sum = a => a.reduce((x, l) => x + Number(l.estimatedValueMToman || 0), 0);\nconst avg = Math.round(leads.reduce((x, l) => x + Number(l.score), 0) / n);\nconst src = {};\nleads.forEach(l => { (src[l.source || 'Unknown'] = src[l.source || 'Unknown'] || []).push(Number(l.score)); });\nconst top = [...leads].sort((a, b) => b.score - a.score).slice(0, 5);\nconst html = `<h2>Weekly Lead Report</h2>\n<p>Total leads: <b>${n}</b> | Avg score: <b>${avg}</b></p>\n<ul>\n<li>Hot: ${by('hot').length} (value ${sum(by('hot'))} M Toman)</li>\n<li>Warm: ${by('warm').length} (value ${sum(by('warm'))} M Toman)</li>\n<li>Cold: ${by('cold').length}</li></ul>\n<h3>Source quality (avg score)</h3><ul>${Object.entries(src).map(([k, v]) =>\n `<li>${k}: ${Math.round(v.reduce((a, b) => a + b, 0) / v.length)} (${v.length} leads)</li>`).join('')}</ul>\n<h3>Top 5 opportunities</h3><ol>${top.map(l =>\n `<li>${l.name} (${l.company || '-'}) – ${l.score} – ${l.nextAction}</li>`).join('')}</ol>`;\nreturn [{ json: { html } }];"
      },
