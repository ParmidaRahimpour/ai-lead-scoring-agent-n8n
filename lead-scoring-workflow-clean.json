      "parameters": {
        "jsCode": "const lead = $('Validate & Normalize').first().json;\nconst last10 = v => String(v ?? '').replace(/\\D/g, '').slice(-10);\nconst dup = $input.all().find(i =>\n  (i.json.phone && last10(i.json.phone) === last10(lead.phone)) ||\n  (i.json.email && String(i.json.email).toLowerCase() === lead.email));\nreturn [{ json: { ...lead, isDuplicate: !!dup } }];"
      },
