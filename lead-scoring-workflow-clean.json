    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst fa = '۰۱۲۳۴۵۶۷۸۹';\nconst norm = s => String(s ?? '').replace(/[۰-۹]/g, d => fa.indexOf(d)).trim();\nlet phone = norm(f['Phone']).replace(/[\\s-]/g, '');\nif (phone.startsWith('+98')) phone = '0' + phone.slice(3);\nelse if (phone.startsWith('98')) phone = '0' + phone.slice(2);\nconst email = norm(f['Email']).toLowerCase();\nconst name = norm(f['Full Name']);\nconst need = norm(f['Need Description']);\nconst errors = [];\nif (name.length < 3) errors.push('invalid name');\nif (!/^09\\d{9}$/.test(phone)) errors.push('invalid phone');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) errors.push('invalid email');\nif (need.length < 10) errors.push('need too short');\nconst optional = ['Company','Role','Company Size','Source'].filter(k => f[k]).length;\nreturn [{ json: {\n  name, company: norm(f['Company']), phone, email,\n  role: f['Role'] || '', size: f['Company Size'] || '',\n  budget: f['Budget'], timeline: f['Timeline'], source: f['Source'] || '',\n  need, valid: errors.length === 0, errors: errors.join(', '),\n  completeness: Math.round(optional / 4 * 100),\n  submittedAt: new Date().toISOString()\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
