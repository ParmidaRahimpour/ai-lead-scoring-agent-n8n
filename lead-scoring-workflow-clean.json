    {
      "parameters": {
        "jsCode": "const lead = $('Duplicate Check').first().json;\nconst ai = $json.output || {};\nconst M = {\n  budget:   {'<50M':0,'50-200M':8,'200-500M':17,'>500M':25},\n  timeline: {'Immediate (<1 month)':20,'1-3 months':13,'3+ months':6,'Just exploring':0},\n  role:     {'Owner/CEO':15,'Manager':11,'Expert':5,'Individual/Student':1},\n  size:     {'1-10':2,'11-50':4,'51-200':7,'200+':10},\n  source:   {'Referral':10,'Event/Webinar':8,'Website':6,'Ads':4,'Social':3}\n};\nconst b = {\n  budget: M.budget[lead.budget] ?? 0,\n  timeline: M.timeline[lead.timeline] ?? 0,\n  authority: M.role[lead.role] ?? 3,\n  companySize: M.size[lead.size] ?? 0,\n  needClarity: Math.max(0, Math.min(10, Number(ai.needClarity) || 0)),\n  source: M.source[lead.source] ?? 2,\n  completeness: Math.round(lead.completeness / 10)\n};\nconst score = Object.values(b).reduce((a, x) => a + x, 0);\nconst tier = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\nconst route = {\n  hot:  ['Direct sales', 'Sales manager calls within 1 hour; book a demo'],\n  warm: ['Sales expert', 'Assign to expert; send proposal within 24h'],\n  cold: ['Nurturing', 'Add to automated email nurture campaign']\n}[tier];\nconst value = {'<50M':25,'50-200M':125,'200-500M':350,'>500M':700}[lead.budget] || 0;\nreturn [{ json: {\n  name: lead.name, company: lead.company, phone: lead.phone, email: lead.email,\n  role: lead.role, size: lead.size, budget: lead.budget, timeline: lead.timeline,\n  source: lead.source, need: lead.need,\n  score, tier, route: route[0], nextAction: route[1],\n  estimatedValueMToman: value,\n  aiSummary: ai.summary || '', productCategory: ai.productCategory || '',\n  breakdown: JSON.stringify(b), status: 'New', createdAt: lead.submittedAt\n}}];"
      },
      "type": "n8n-nodes-base.code",
